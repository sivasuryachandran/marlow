{
  "name": "marlow",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "vite web",
    "build": "vite build web",
    "check-access": "node --env-file=.env --import tsx tools/check-access.ts",
    "replay": "tsx tools/replay.ts",
    "server": "node --env-file=.env --import tsx server/src/index.ts",
    "eval": "node --env-file=.env --import tsx tools/eval.ts",
    "render-lines": "tsx tools/render-lines.ts",
    "author-mission": "tsx tools/author-mission.ts --validate",
    "casefile": "tsx tools/casefile.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}