# Meta Model API (https://dev.meta.ai) — never commit real keys
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Baseten (Muse Spark Open: meta-models/muse-spark-open)
BASETEN_API_KEY=
INTENT_BACKEND=meta   # meta (Muse Spark, the demo default) | baseten (Muse Spark Open, id meta-models/muse-spark-open) | mock (offline). Unset = meta if MODEL_API_KEY is set, else mock
TURN_TIMEOUT_MS=7000   # measured Spark p95 is ~6.5 s; the brief started at 4000
FIREWORKS_API_KEY=   # optional partner credits; not wired yet
